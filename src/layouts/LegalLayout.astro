---
import { site } from '../config/site';
import Layout from './Layout.astro';
import SiteTopbar from '../components/SiteTopbar.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
}

const { title, description, heading } = Astro.props;
---

<Layout title={`${title} | ${site.name}`} description={description}>
  <header class="site-header" id="top">
    <SiteTopbar homeHref="/" ctaHref="/#callback" />
  </header>

  <main id="main-content" class="legal-main">
    <div class="legal-shell">
      <nav class="legal-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span>{heading}</span>
      </nav>
      <article class="legal-card">
        <header class="legal-title">
          <p>Website information</p>
          <h1>{heading}</h1>
          <span>Last updated: {site.legal.updated}</span>
        </header>
        <div class="legal-copy"><slot /></div>
      </article>
    </div>
  </main>

  <footer class="legal-footer">
    <div class="legal-shell legal-footer-inner">
      <p>&copy; 2026 {site.name}. Fictional demonstration brand. Replace demo legal and contact details before a client launch.</p>
      <nav aria-label="Legal navigation">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/accessibility/">Accessibility</a>
        <a href="/cookies/">Cookies</a>
      </nav>
    </div>
  </footer>

  <style>
    .legal-shell { width: min(1040px, calc(100% - 48px)); margin-inline: auto; }
    .legal-main { min-height: 70vh; padding: 52px 0 76px; background: var(--rooftero-cream); }
    .legal-breadcrumb { display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 20px; color: var(--rooftero-muted); font-size: 14px; }
    .legal-breadcrumb a { color: var(--rooftero-heading); font-weight: 700; text-decoration: none; }
    .legal-card { overflow: hidden; border: 1px solid var(--rooftero-border); border-radius: var(--rooftero-radius-md); background: var(--rooftero-white); box-shadow: var(--rooftero-shadow-md); }
    .legal-title { padding: clamp(30px, 5vw, 52px); border-bottom: 4px solid var(--rooftero-orange); background: var(--rooftero-forest-800); color: var(--rooftero-cream); }
    .legal-title p { color: var(--rooftero-orange-light); font-size: 14px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
    .legal-title h1 { margin-top: 8px; color: var(--rooftero-cream); font-size: clamp(40px, 7vw, 68px); line-height: .95; }
    .legal-title span { display: block; margin-top: 18px; color: #e7e1d7; font-size: 14px; }
    .legal-copy { padding: clamp(28px, 5vw, 54px); color: var(--rooftero-text); }
    .legal-copy :global(h2) { margin: 36px 0 12px; color: var(--rooftero-heading); font-size: clamp(25px, 3vw, 34px); line-height: 1.1; }
    .legal-copy :global(h2:first-child) { margin-top: 0; }
    .legal-copy :global(h3) { margin: 25px 0 8px; color: var(--rooftero-heading); font-size: 20px; line-height: 1.2; }
    .legal-copy :global(p), .legal-copy :global(li) { line-height: 1.75; }
    .legal-copy :global(p + p) { margin-top: 14px; }
    .legal-copy :global(ul) { display: grid; gap: 8px; padding-left: 22px; }
    .legal-copy :global(a) { color: var(--rooftero-orange-dark); font-weight: 700; }
    .legal-copy :global(.legal-note) { margin-top: 32px; padding: 16px 18px; border-left: 4px solid var(--rooftero-orange); background: var(--rooftero-cream); }
    .legal-footer { padding: 24px 0; background: var(--rooftero-forest-900); color: var(--rooftero-cream); }
    .legal-footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 18px 30px; }
    .legal-footer p { max-width: 620px; font-size: 12px; }
    .legal-footer nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px 16px; }
    .legal-footer a { color: var(--rooftero-orange-light); font-size: 13px; text-decoration: none; }
    @media (max-width: 680px) {
      .legal-shell { width: calc(100% - 40px); }
      .legal-main { padding-block: 36px 58px; }
      .legal-footer-inner { align-items: flex-start; flex-direction: column; }
      .legal-footer nav { justify-content: flex-start; }
    }
  </style>
</Layout>
