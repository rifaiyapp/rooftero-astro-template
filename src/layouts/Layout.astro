---
import { site } from '../config/site';
import '../styles/icons.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.seo.title,
  description = site.seo.description,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#183a33" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />
    <meta name="author" content="KEYDIV" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href={site.favicon.large} />
    <link rel="icon" type="image/png" sizes="16x16" href={site.favicon.small} />
    <link rel="shortcut icon" href={site.favicon.ico} />
    <link rel="icon" type="image/svg+xml" href={site.favicon.svg} />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png" />
    <link rel="preload" href="/assets/fonts/league-spartan-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
