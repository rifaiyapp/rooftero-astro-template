---
import Layout from "../layouts/Layout.astro";
import { site } from "../config/site";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Layout title={`Thank You | ${site.name}`} description="Your roof inspection request has been received.">
  <main class="thank-you-page" id="main-content">
    <picture class="hero-media" aria-hidden="true">
      <source media="(max-width: 820px)" type="image/avif" srcset={`${base}assets/optimized/hero-roofing-1280.avif`} />
      <source type="image/avif" srcset={`${base}assets/optimized/hero-roofing-1920.avif`} />
      <source media="(max-width: 820px)" type="image/webp" srcset={`${base}assets/optimized/hero-roofing-1280.webp`} />
      <img src={`${base}assets/optimized/hero-roofing-1920.webp`} width="1920" height="850" alt="" loading="eager" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero-shade" aria-hidden="true"></div>
    <header class="thank-you-header">
      <a class="brand" href={base} aria-label={`${site.name} home`}>
        <img src={`${base}${site.logo.src.replace(/^\//, "")}`} alt={site.logo.alt} width="430" height="161" loading="eager" />
      </a>
    </header>
    <section class="thank-you-content hero-copy shell" aria-labelledby="thank-you-title">
      <p class="eyebrow">Request received</p>
      <h1 id="thank-you-title">Thank you!</h1>
      <p>Your free roof inspection request has been received. A {site.name} roofing specialist will contact you shortly.</p>
      <a class="button button-gold" href={base}>Back to Home</a>
    </section>
  </main>
</Layout>
