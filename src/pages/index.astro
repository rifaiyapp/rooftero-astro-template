  <script>
    const toggle = document.querySelector('.menu-toggle');
    const nav = document.querySelector('#site-nav');
    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      nav?.classList.toggle('open', !open);
    });
    nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { toggle?.setAttribute('aria-expanded', 'false'); nav.classList.remove('open'); }));

    const reviewCarousel = document.querySelector<HTMLElement>('.testimonial-carousel');
    const reviewTrack = reviewCarousel?.querySelector<HTMLElement>('.testimonial-track');
    const reviewDots = Array.from(reviewCarousel?.querySelectorAll<HTMLButtonElement>('[data-review-dot]') ?? []);
    const originalReviewCards = Array.from(reviewTrack?.querySelectorAll<HTMLElement>('[data-review]') ?? []);
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let visibleReviews = 3;
    let trackReview = 0;
    let activeReview = 0;
    let reviewTransitioning = false;
    let reviewSettleTimer = 0;
    let reviewAutoplay = 0;
    let reviewHovering = false;
    let reviewFocused = false;
    let reviewTouchStart = 0;
    let reviewStep = 0;

    const getVisibleReviews = () => window.innerWidth <= 520 ? 1 : window.innerWidth <= 1050 ? 2 : 3;
    const getReviewStep = () => {
      const card = reviewTrack?.querySelector<HTMLElement>('.testimonial-card');
      if (!card || !reviewTrack) return 0;
      const gap = parseFloat(getComputedStyle(reviewTrack).columnGap || getComputedStyle(reviewTrack).gap) || 0;
      return card.getBoundingClientRect().width + gap;
    };
    const syncReviewDots = () => reviewDots.forEach((dot, index) => dot.setAttribute('aria-current', String(index === activeReview)));
    const positionReviews = (animate = true) => {
      if (!reviewTrack) return;
      const step = reviewStep;
      reviewTrack.style.transition = animate && !reducedMotion.matches ? '' : 'none';
      reviewTrack.style.transform = `translate3d(${-trackReview * step}px, 0, 0)`;
    };
    const settleReviews = () => {
      if (!reviewTrack || !originalReviewCards.length) return;
      if (trackReview >= originalReviewCards.length + visibleReviews) trackReview -= originalReviewCards.length;
      if (trackReview < visibleReviews) trackReview += originalReviewCards.length;
      positionReviews(false);
      reviewTransitioning = false;
    };
    const showReview = (direction: number) => {
      if (!reviewTrack || reviewTransitioning) return;
      reviewTransitioning = true;
      trackReview += direction;
      activeReview = (activeReview + direction + originalReviewCards.length) % originalReviewCards.length;
      syncReviewDots();
      positionReviews(true);
      window.clearTimeout(reviewSettleTimer);
      reviewSettleTimer = window.setTimeout(settleReviews, reducedMotion.matches ? 20 : 540);
    };
    const rebuildReviews = () => {
      if (!reviewTrack || !originalReviewCards.length) return;
      reviewTrack.querySelectorAll('.is-clone').forEach((clone) => clone.remove());
      visibleReviews = getVisibleReviews();
      const makeClone = (card: HTMLElement) => {
        const clone = card.cloneNode(true) as HTMLElement;
        clone.classList.add('is-clone');
        clone.removeAttribute('data-review');
        clone.setAttribute('aria-hidden', 'true');
        clone.setAttribute('role', 'presentation');
        return clone;
      };
      const leading = document.createDocumentFragment();
      originalReviewCards.slice(-visibleReviews).forEach((card) => leading.append(makeClone(card)));
      reviewTrack.prepend(leading);
      originalReviewCards.slice(0, visibleReviews).forEach((card) => reviewTrack.append(makeClone(card)));
      trackReview = visibleReviews + activeReview;
      positionReviews(false);
      syncReviewDots();
    };
    const syncReviewAutoplay = () => {
      window.clearInterval(reviewAutoplay);
      reviewAutoplay = 0;
      if (!reviewCarousel || reducedMotion.matches || document.hidden || reviewHovering || reviewFocused) return;
      reviewAutoplay = window.setInterval(() => showReview(1), 6500);
    };

    reviewCarousel?.querySelector('.review-arrow.prev')?.addEventListener('click', () => showReview(-1));
    reviewCarousel?.querySelector('.review-arrow.next')?.addEventListener('click', () => showReview(1));
    reviewDots.forEach((dot, index) => dot.addEventListener('click', () => {
      if (!reviewTrack || index === activeReview) return;
      activeReview = index;
      trackReview = visibleReviews + activeReview;
      syncReviewDots();
      positionReviews(true);
    }));
    reviewTrack?.addEventListener('transitionend', settleReviews);
    reviewCarousel?.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      showReview(event.key === 'ArrowLeft' ? -1 : 1);
    });
    reviewCarousel?.addEventListener('mouseenter', () => { reviewHovering = true; syncReviewAutoplay(); });
    reviewCarousel?.addEventListener('mouseleave', () => { reviewHovering = false; syncReviewAutoplay(); });
    reviewCarousel?.addEventListener('focusin', () => { reviewFocused = true; syncReviewAutoplay(); });
    reviewCarousel?.addEventListener('focusout', () => window.setTimeout(() => {
      reviewFocused = Boolean(reviewCarousel?.matches(':focus-within'));
      syncReviewAutoplay();
    }, 0));
    reviewCarousel?.addEventListener('touchstart', (event) => { reviewTouchStart = event.changedTouches[0]?.clientX ?? 0; }, { passive: true });
    reviewCarousel?.addEventListener('touchend', (event) => {
      const distance = (event.changedTouches[0]?.clientX ?? reviewTouchStart) - reviewTouchStart;
      if (Math.abs(distance) > 45) showReview(distance < 0 ? 1 : -1);
    }, { passive: true });
    document.addEventListener('visibilitychange', syncReviewAutoplay);
    reducedMotion.addEventListener('change', () => { positionReviews(false); syncReviewAutoplay(); });
    let reviewResizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(reviewResizeTimer);
      reviewResizeTimer = window.setTimeout(rebuildReviews, 120);
    });
    // Read card geometry after layout; user interactions only write transforms.
    if (reviewTrack && originalReviewCards[0]) {
      new ResizeObserver(() => {
        reviewStep = getReviewStep();
        positionReviews(false);
      }).observe(originalReviewCards[0]);
    }
    rebuildReviews();
    syncReviewAutoplay();

    const faqButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.faq-question'));
    const setFaqState = (button: HTMLButtonElement, expanded: boolean) => {
      const answerId = button.getAttribute('aria-controls');
      const answer = answerId ? document.getElementById(answerId) : null;
      button.setAttribute('aria-expanded', String(expanded));
      if (answer) {
        answer.setAttribute('aria-hidden', String(!expanded));
        answer.toggleAttribute('inert', !expanded);
      }
    };
    faqButtons.forEach((button, index) => {
      button.addEventListener('click', () => {
        const willOpen = button.getAttribute('aria-expanded') !== 'true';
        faqButtons.forEach((item) => setFaqState(item, item === button && willOpen));
      });
      button.addEventListener('keydown', (event) => {
        if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const targetIndex = event.key === 'Home' ? 0 : event.key === 'End' ? faqButtons.length - 1 : event.key === 'ArrowDown' ? (index + 1) % faqButtons.length : (index - 1 + faqButtons.length) % faqButtons.length;
        faqButtons[targetIndex]?.focus();
      });
    });

    const callbackForm = document.querySelector<HTMLFormElement>('.callback-card');
    const mobileActionBar = document.querySelector<HTMLElement>('.mobile-action-bar');
    const siteFooter = document.querySelector<HTMLElement>('.site-footer');
    const mobileActionObstructions = [callbackForm, siteFooter].filter((element): element is HTMLElement => Boolean(element));
    if (mobileActionBar && 'IntersectionObserver' in window) {
      const visibleObstructions = new Set<Element>();
      const obstructionObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visibleObstructions.add(entry.target);
          else visibleObstructions.delete(entry.target);
        });
        mobileActionBar.classList.toggle('is-obscured', visibleObstructions.size > 0);
      }, { threshold: .05 });
      mobileActionObstructions.forEach((element) => obstructionObserver.observe(element));
    }
    import { connectLeadForm } from '../scripts/lead-form';
    if (callbackForm) connectLeadForm(callbackForm);

  </script>
