---
import { site } from '../config/site';
import Layout from '../layouts/Layout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';

const benefits = [
  { icon: 'ph-clock-countdown', title: 'We arrive on time', text: 'Clear arrival windows and real updates from your local crew.' },
  { icon: 'ph-receipt', title: 'Up-front pricing', text: 'Know the full scope and price before any roofing work begins.' },
  { icon: 'ph-shield-check', title: 'Built right, first time', text: 'Detail-led workmanship backed by a written protection plan.' },
  { icon: 'ph-cloud-lightning', title: 'Fast storm response', text: 'Urgent tarping and leak control when bad weather hits.' },
];

const services = [
  { icon: 'ph-hammer', title: 'Roof repairs', text: 'Leaks, flashing, storm damage and missing shingles.', image: '/assets/about-roof-detail.jpg', alt: 'Roofer completing a detailed shingle repair', width: 1200, height: 896, position: 'repair' },
  { icon: 'ph-magnifying-glass', title: 'Roof inspections', text: 'Photo-documented checks and honest repair advice.', image: '/assets/about-roof-inspect.jpg', alt: 'Roof inspector checking a residential roof', width: 1200, height: 896, position: 'inspection', featured: true },
  { icon: 'ph-house-line', title: 'Roof replacement', text: 'Complete, code-compliant reroofing built to last.', image: '/assets/roofing-services.png', alt: 'Roofing crew installing replacement shingles', width: 1600, height: 1100, position: 'replacement' },
];

const testimonials = [
  { quote: 'Rooflume found the leak two other companies missed. The repair was neat, the price matched the quote, and our home was spotless afterward.', name: 'Monica R.', area: 'North Hills' },
  { quote: 'From the inspection to the final magnet sweep, the team communicated brilliantly. Our new roof looks fantastic and feels ready for anything.', name: 'Daniel K.', area: 'Brookside' },
  { quote: 'A storm peeled shingles off overnight. Rooflume had the roof protected that morning and completed the permanent repair two days later.', name: 'Avery T.', area: 'Riverside' },
  { quote: 'The crew walked us through every repair option, protected the landscaping, and left the property clean at the end of each day.', name: 'Roofing Customer', area: 'Eastgate' },
  { quote: 'Our replacement schedule stayed organized from delivery through cleanup. The updates were clear, practical, and easy to understand.', name: 'Roofing Customer', area: 'Westfield' },
  { quote: 'After heavy rain exposed a flashing issue, the team documented the problem and completed a tidy repair without any runaround.', name: 'Roofing Customer', area: 'Lakeview' },
];

const faqs = [
  { question: 'Do you provide emergency roof repairs?', answer: 'Yes. Call as soon as it is safe to do so. We prioritize active leaks and storm openings, then inspect the damage and explain whether temporary protection or a permanent repair is the right next step.' },
  { question: 'Is the initial roof inspection free?', answer: 'Our initial roof check is free for homeowners in our listed service area. We document visible concerns, explain the practical options, and provide a clear scope before any paid work begins.' },
  { question: 'How do I know if I need repair or replacement?', answer: 'A focused repair may be appropriate when damage is limited and the surrounding roof is still serviceable. Replacement may make more sense when damage is widespread, recurring, or the roof system is near the end of its useful life.' },
  { question: 'How long does a roof replacement take?', answer: 'Timing depends on roof size, complexity, materials, weather, and any deck repairs discovered after removal. Your written proposal will include the expected schedule, and the crew will keep you updated if conditions change.' },
  { question: 'Can you help with storm-damage insurance documentation?', answer: 'We can photograph visible damage and provide a written roofing scope for your records. Coverage decisions and claim approvals remain between you and your insurance carrier, and we do not promise a particular claim outcome.' },
];
---

<Layout>
  <header class="site-header" id="top">
    <div class="topbar shell">
      <a class="brand" href="#top" aria-label={`${site.name} home`}>
        <ResponsiveImage src={site.logo.src} alt={site.logo.alt} width="430" height="161" loading="eager" sizes="(max-width: 520px) 185px, (max-width: 820px) 205px, 285px" />
      </a>
      <a class="phone-lockup header-phone" href={site.phone.href} aria-label={`Call ${site.name} at ${site.phone.display}`}>
        <span class="phone-icon"><i class="ph-fill ph-phone-call" aria-hidden="true"></i></span>
        <span class="phone-copy"><small>Book Same-Day Service</small><strong>Call {site.phone.display}</strong></span>
      </a>
      <a class="button button-gold header-cta" href="#callback">{site.primaryCta}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
        <i class="ph ph-list" aria-hidden="true"></i>
      </button>
    </div>

    <nav class="nav-shell shell" id="site-nav" aria-label="Primary navigation">
      <ul class="nav-inner">
        <li><a class="active" href="#home" aria-current="page">Home</a></li>
        <li><a href="#promise">Why Us</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#process">How It Works</a></li>
        <li><a href="#reviews">Reviews</a></li>
        <li><a href="#faq">FAQ</a></li>
        <li><a href="#roof-check">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main id="main-content">
    <div class="hero-promise-canvas">
    <section class="hero" id="home" aria-labelledby="hero-title">
      <picture class="hero-media" aria-hidden="true">
        <source media="(max-width: 820px)" type="image/avif" srcset="/assets/optimized/hero-roofing-1280.avif" />
        <source type="image/avif" srcset="/assets/optimized/hero-roofing-1920.avif" />
        <source media="(max-width: 820px)" type="image/webp" srcset="/assets/optimized/hero-roofing-1280.webp" />
        <img src="/assets/optimized/hero-roofing-1920.webp" width="1920" height="850" alt="" loading="eager" fetchpriority="high" decoding="async" />
      </picture>
      <div class="hero-shade"></div>
      <div class="shell hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Local roofers. Lasting protection.</p>
          <h1 id="hero-title"><span>Fixed today.</span><strong>Not next storm.</strong><span class="h1-context">Roof repair and replacement in North Hills and the greater metro area.</span></h1>
          <p>Responsive roof repair and replacement from licensed professionals who respect your time, home, and budget.</p>
          <div class="hero-actions">
            <a class="phone-lockup light" href={site.phone.href} aria-label={`Call a local ${site.name} roofer at ${site.phone.display}`}>
              <span class="phone-icon"><i class="ph ph-phone-call" aria-hidden="true"></i></span>
              <span><small>Talk with a local roofer</small><strong>{site.phone.display}</strong></span>
            </a>
            <a class="button button-gold" href="#callback">{site.primaryCta}</a>
          </div>
          <ul class="hero-proof" aria-label="Service assurances">
            <li><i class="ph-fill ph-seal-check" aria-hidden="true"></i> Licensed & insured</li>
            <li><i class="ph-fill ph-star" aria-hidden="true"></i> 4.9 homeowner rating</li>
          </ul>
        </div>

        <form class="callback-card hero-callback" id="callback" method="dialog" novalidate aria-labelledby="callback-title">
          <div aria-hidden="true" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);pointer-events:none;">
            <label for="callback-website">Website</label>
            <input id="callback-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="hero-form-panel">
            <div class="form-header"><p>Need roofing help?</p><h2 id="callback-title">Free roof inspection</h2></div>
            <div class="form-body">
              <label for="name">Name</label><input id="name" name="name" autocomplete="name" required placeholder="Your name" />
              <label for="phone">Phone number</label><input id="phone" name="phone" autocomplete="tel" inputmode="tel" required placeholder={site.phone.display} />
              <label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required placeholder="hello@example.com" />
              <label for="zip">ZIP Code</label><input id="zip" name="zip" autocomplete="postal-code" inputmode="numeric" required pattern="[0-9]{5}(-[0-9]{4})?" maxlength="10" title="Enter a 5-digit ZIP Code or ZIP+4." placeholder="ZIP Code" />
              <label for="message">How can we help?</label><textarea id="message" name="message" rows="2" required placeholder="Tell us about your roof"></textarea>
              <button class="button button-gold submit-button" type="submit">{site.primaryCta}</button>
              <p class="form-note">No spam. No obligation.</p><p class="form-status" role="status" aria-live="polite"></p>
            </div>
          </div>
        </form>
      </div>
    </section>

    <section class="benefits angled-bottom" id="promise" aria-labelledby="benefits-title">
      <div class="shell section-stack">
        <div class="section-heading navy">
          <span>Why choose us</span>
          <h2 id="benefits-title">The {site.name} promise</h2>
        </div>
        <div class="benefit-grid">
          {benefits.map((item) => (
            <article class="benefit-card">
              <div class="icon-medallion"><i class={`ph ${item.icon}`} aria-hidden="true"></i></div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
    </div>

    <section class="services" id="services" aria-labelledby="services-title">
      <div class="shell section-stack">
        <div class="section-heading light">
          <span>What we do</span>
          <h2 id="services-title">Roofing services</h2>
        </div>
        <div class="service-grid">
          {services.map((service) => (
            <article class:list={['service-card', { featured: service.featured }]}>
              <div class={`service-image ${service.position}`}>
                <ResponsiveImage src={service.image} alt={service.alt} width={service.width} height={service.height} loading="lazy" decoding="async" />
              </div>
              <div class="service-card-body">
                <div class="service-icon"><i class={`ph ${service.icon}`} aria-hidden="true"></i></div>
                <h3>{service.title}</h3>
                <p>{service.text}</p>
                <a href="#callback" aria-label={`Request an estimate for ${service.title}`}>Free Quote <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about shell" id="about" aria-labelledby="about-title">
      <div class="about-media" aria-label={`${site.name} roofing services in action`}>
        <div class="about-media-card main-card">
          <ResponsiveImage src="/assets/roofing-services.png" alt="Professional roofing crew installing shingles with safety harnesses" width="1600" height="1100" loading="lazy" decoding="async" />
        </div>
        <div class="about-media-card inspect-card">
          <ResponsiveImage src="/assets/about-roof-inspect.jpg" alt="Roof inspector conducting detailed slope and flashing assessment" width="1200" height="896" loading="lazy" decoding="async" />
        </div>
        <div class="about-media-card detail-card">
          <ResponsiveImage src="/assets/about-roof-detail.jpg" alt="Close-up of precise architectural shingle nailing and alignment" width="1200" height="896" loading="lazy" decoding="async" />
        </div>
        <div class="about-media-badge">
          <span class="badge-icon"><i class="ph-fill ph-seal-check" aria-hidden="true"></i></span>
          <div class="badge-copy">
            <strong>Local Roofing Experts</strong>
            <small>Certified • Safe • Guaranteed</small>
          </div>
        </div>
      </div>
      <div class="about-copy">
        <p class="script-label">About us</p>
        <h2 id="about-title">Roofing without the runaround</h2>
        <p class="lead">We started {site.name} because homeowners deserved a roofer who calls back, shows up, and stands behind the work.</p>
        <p>From pinpoint repairs to complete replacement, our team combines clear recommendations, careful protection of your property, and documentation at every stage. You always know what is happening above your head.</p>
        <div class="compact-actions">
          <a class="phone-lockup" href={site.phone.href} aria-label={`Call the ${site.name} team at ${site.phone.display}`}><span class="phone-icon"><i class="ph ph-phone-call" aria-hidden="true"></i></span><span><small>Speak with our team</small><strong>{site.phone.display}</strong></span></a>
          <a class="button button-navy" href="#process">Our process</a>
        </div>
        <div class="about-trust">
          <div class="about-trust-item">
            <div class="about-trust-icon"><i class="ph ph-medal" aria-hidden="true"></i></div>
            <div class="about-trust-copy">
              <strong>Licensed & insured</strong>
              <span>Professional roofing crews</span>
            </div>
          </div>
          <div class="about-trust-item">
            <div class="about-trust-icon"><i class="ph ph-shield-checkered" aria-hidden="true"></i></div>
            <div class="about-trust-copy">
              <strong>Trusted materials</strong>
              <span>Manufacturer-backed products</span>
            </div>
          </div>
          <div class="about-trust-item">
            <div class="about-trust-icon"><i class="ph ph-hard-hat" aria-hidden="true"></i></div>
            <div class="about-trust-copy">
              <strong>Written protection</strong>
              <span>Clear workmanship terms</span>
            </div>
          </div>
          <div class="about-trust-item">
            <div class="about-trust-icon"><i class="ph ph-map-pin" aria-hidden="true"></i></div>
            <div class="about-trust-copy">
              <strong>Local service</strong>
              <span>Metro-area roofing team</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="process angled-bottom" id="process" aria-labelledby="process-title">
      <div class="shell section-stack">
        <div class="section-heading navy">
          <span>Our process</span>
          <h2 id="process-title">How it works</h2>
        </div>
        <div class="process-stage">
          <div class="process-track" aria-hidden="true">
            <svg class="process-wave" viewBox="0 0 1200 220" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Chevrons left, vertically centred at y=63 (icon center in grid coords) -->
              <path class="wave-chevron" d="M10 54l11 9-11 9M24 54l11 9-11 9" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
              <!-- Wave enters at chevron level (~63), dips through step 1, crests above center card icon, dips through step 3, exits upper right -->
              <path class="wave-path" d="M40 63 C 115 90, 175 94, 235 94 C 355 94, 440 20, 600 20 C 760 20, 845 94, 965 94 C 1035 94, 1080 48, 1128 8" stroke="currentColor" stroke-width="2.5" stroke-dasharray="8 8" stroke-linecap="round" />
              <!-- Paper plane at the end of the path -->
              <g transform="translate(1105,0) rotate(-25) scale(0.88)">
                <path class="wave-plane" d="M0 16L32 0L14 32L11 20L0 16z M11 20L32 0" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
              </g>
            </svg>
          </div>
          <div class="process-grid">
            <article class="process-step">
              <div class="process-icon">
                <svg class="process-svg-icon" viewBox="0 0 1024 1024" fill="currentColor" aria-hidden="true">
                  <path d="M832 128h-96v-32c0-17.673-14.327-32-32-32s-32 14.327-32 32v32h-320v-32c0-17.673-14.327-32-32-32s-32 14.327-32 32v32h-96c-35.346 0-64 28.654-64 64v640c0 35.346 28.654 64 64 64h640c35.346 0 64-28.654 64-64v-640c0-35.346-28.654-64-64-64zM288 192v32c0 17.673 14.327 32 32 32s32-14.327 32-32v-32h320v32c0 17.673 14.327 32 32 32s32-14.327 32-32v-32h96v128h-640v-128h128zM832 832h-640v-448h640v448zM678.64 489.36c5.798 5.792 9.385 13.797 9.385 22.64s-3.587 16.848-9.385 22.64l-192 192c-5.792 5.798-13.797 9.385-22.64 9.385s-16.848-3.587-22.64-9.385l-96-96c-5.794-5.794-9.378-13.799-9.378-22.64 0-17.683 14.335-32.018 32.018-32.018 8.841 0 16.846 3.584 22.64 9.378l73.36 73.4 169.36-169.4c5.792-5.798 13.797-9.385 22.64-9.385s16.848 3.587 22.64 9.385z" />
                </svg>
              </div>
              <h3>CALL <em>OR</em><br />BOOK ONLINE</h3>
              <p>Tell us what you need</p>
            </article>

            <article class="process-step featured">
              <div class="process-icon">
                <svg class="process-svg-icon" viewBox="0 0 1024 1024" fill="currentColor" aria-hidden="true">
                  <path d="M1021.68 468l-56-140c-9.668-23.645-32.494-40-59.141-40h-138.539v-32c0-17.673-14.327-32-32-32h-608c-35.346 0-64 28.654-64 64v448c0 35.346 28.654 64 64 64h68c14.63 55.774 64.588 96.251 124 96.251s109.37-40.477 124-96.251h200c14.63 55.774 64.588 96.251 124 96.251s109.37-40.477 124-96.251h68c35.346 0 64-28.654 64-64v-256c0-4.295-.852-8.39-2.32-12zM768 352h138.32l38.4 96h-176.72v-96zM128 288h576v256h-576v-256zM320 832c-35.346 0-64-28.654-64-64s28.654-64 64-64 64 28.654 64 64-28.654 64-64 64zM644 736h-200c-14.63-55.774-64.588-96.251-124-96.251s-109.37 40.477-124 96.251h-68v-128h576v49.24c-29.355 17.188-50.963 44.911-60 78.76zM768 832c-35.346 0-64-28.654-64-64s28.654-64 64-64 64 28.654 64 64-28.654 64-64 64zM960 736h-68c-14.799-55.621-64.683-95.942-124-96v-128h192v224z" />
                </svg>
              </div>
              <h3>WE ARRIVE<br />SAME DAY</h3>
              <p>On time, ready to go</p>
            </article>

            <article class="process-step">
              <div class="process-icon">
                <svg class="process-svg-icon" viewBox="0 0 1024 1024" fill="currentColor" aria-hidden="true">
                  <path d="M907.04 276c-4.878-11.826-16.316-19.998-29.664-19.998-8.382 0-16.012 3.223-21.696 8.479l-161.2 148.76-68.92-14.8-14.8-68.92 148.76-161.2c5.255-5.684 8.478-13.314 8.478-21.696 0-13.347-8.172-24.786-19.998-29.664-31.956-13.295-69.076-21.017-108-21.017-159.058 0-288 128.942-288 288 0 41.861 8.833 81.526 24 115.76l-240.84 208.24c-.6.48-1.16 1.04-1.72 1.56-23.166 23.166-37.495 55.17-37.495 90.52 0 70.701 57.314 128.015 128.015 128.015 35.35 0 67.354-14.329 90.52-37.495.52-.52 1.08-1.12 1.56-1.68l208.2-240.92c34.079 15.348 73.875 24.289 115.76 24.289 159.058 0 288-128.942 288-288 0-38.922-7.701-75.877-20.96-108zM640 608c-39.745-.056-77.055-10.429-108.28-28-4.462-2.511-9.795-3.99-15.474-3.99-9.652 0-18.305 4.273-24.207 11.07l-223.6 258.96c-11.453 10.897-26.984 17.601-44.081 17.601-35.346 0-64-28.654-64-64 0-17.097 6.704-32.628 17.602-44.081l258.76-223.56c6.806-5.901 11.085-14.56 11.085-24.219 0-5.689-1.485-11.032-4.005-15.501-17.6-31.252-27.968-68.608-27.968-108.386 0-123.712 100.288-224 224-224 13.214 0 26.161 1.144 37.408 2.95l-124.8 135.24c-5.251 5.683-8.472 13.31-8.472 21.689 0 2.377.259 4.694.712 6.711l22.64 105.32c2.715 12.316 12.244 21.845 24.56 24.56l105.4 22.64c2.017.452 4.334.712 6.711.712 8.379 0 16.006-3.221 21.689-8.471l135.24-124.8c1.968 11.16 3.094 24.008 3.094 37.12 0 123.765-100.267 224.111-224.014 224.24z" />
                </svg>
              </div>
              <h3>WE FIX IT<br />PROPERLY</h3>
              <p>Done right the first time</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="testimonials" id="reviews" aria-labelledby="reviews-title">
      <div class="shell section-stack">
        <div class="section-heading light">
          <span>Homeowners say it best</span>
          <h2 id="reviews-title">Protected homes. Happy clients.</h2>
        </div>
        <div class="testimonial-carousel" role="region" aria-roledescription="carousel" aria-label="Customer reviews" tabindex="0">
          <div class="testimonial-stage">
            <button class="review-arrow prev" type="button" aria-label="Previous testimonial"><i class="ph ph-caret-left" aria-hidden="true"></i></button>
            <div class="testimonial-grid">
              <div class="testimonial-track" aria-live="polite">
                {testimonials.map((item, index) => (
                  <blockquote class="testimonial-card" data-review={index} role="group" aria-roledescription="slide" aria-label={`Review ${index + 1} of ${testimonials.length}`}>
                    <div class="quote-mark">
                      <svg viewBox="0 0 448 512" width="30" height="30" fill="currentColor" aria-hidden="true">
                        <path d="M0 216C0 149.7 53.7 96 120 96h8c17.7 0 32 14.3 32 32s-14.3 32-32 32h-8c-30.9 0-56 25.1-56 56v8h64c35.3 0 64 28.7 64 64v64c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V216zm256 0c0-66.3 53.7-120 120-120h8c17.7 0 32 14.3 32 32s-14.3 32-32 32h-8c-30.9 0-56 25.1-56 56v8h64c35.3 0 64 28.7 64 64v64c0 35.3-28.7 64-64 64h-64c-35.3 0-64-28.7-64-64V216z" />
                      </svg>
                    </div>
                    <p>“{item.quote}”</p>
                    <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
                    <small class="google-review">Google Review</small>
                    <footer><strong>{item.name}</strong><span>{item.area}</span></footer>
                  </blockquote>
                ))}
              </div>
            </div>
            <button class="review-arrow next" type="button" aria-label="Next testimonial"><i class="ph ph-caret-right" aria-hidden="true"></i></button>
          </div>
          <div class="testimonial-pagination" role="group" aria-label="Choose a testimonial">
            {testimonials.map((_, index) => <button type="button" data-review-dot={index} aria-label={`Show review ${index + 1}`} aria-current={index === 0 ? 'true' : 'false'}></button>)}
          </div>
          <div class="satisfaction-commitment">
            <strong>Customer Satisfaction Commitment</strong>
            <small>Clear communication <b aria-hidden="true">•</b> Respectful crews <b aria-hidden="true">•</b> Quality workmanship</small>
          </div>
        </div>
      </div>
    </section>

    <section class="roofing-faq-section" id="faq" aria-labelledby="faq-title">
      <div class="roofing-faq shell">
        <div class="roofing-faq-content">
          <p class="roofing-faq-label">Roofing FAQ</p>
          <h2 id="faq-title" class="roofing-faq-title"><span>Roofing Questions?</span><strong>We&rsquo;ve Got Answers.</strong></h2>
          <p class="roofing-faq-intro">Clear answers to the most common roofing questions homeowners ask. If you don&rsquo;t see your question here, give us a call&mdash;we&rsquo;re happy to help.</p>

          <div class="faq-list">
            {faqs.map((faq, index) => (
              <article class="faq-item">
                <h3>
                  <button class="faq-question" type="button" aria-expanded="false" aria-controls={`faq-answer-${index}`} id={`faq-question-${index}`}>
                    <span class="faq-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <span>{faq.question}</span>
                    <i class="ph ph-caret-down" aria-hidden="true"></i>
                  </button>
                </h3>
