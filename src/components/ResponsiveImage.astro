---
import manifest from '../assets/image-manifest.json';
interface Props { src: string; alt: string; sizes?: string; width?: number | string; height?: number | string; loading?: 'lazy' | 'eager'; decoding?: 'async' | 'sync' | 'auto'; fetchpriority?: 'high' | 'low' | 'auto'; }
const { src, alt, sizes = '(max-width: 520px) calc(100vw - 24px), (max-width: 820px) 520px, 600px', width, height, loading = 'lazy', decoding = 'async', fetchpriority } = Astro.props;
const file = src.split('/').pop() as keyof typeof manifest;
const asset = manifest[file];
const stem = file.replace(/\.[^.]+$/, '');
const set = (format: string) => asset.widths.map(w => `/assets/optimized/${stem}-${w}.${format} ${w}w`).join(', ');
---
<picture class="responsive-picture">
  <source type="image/avif" srcset={set('avif')} sizes={sizes} />
  <img src={`/assets/optimized/${stem}-${asset.widths.at(-1)}.webp`} srcset={set('webp')} sizes={sizes} alt={alt} width={width ?? asset.width} height={height ?? asset.height} loading={loading} decoding={decoding} fetchpriority={fetchpriority} />
</picture>

<style>
  .responsive-picture { display: contents; }
</style>
